# ---------------------------------------------------------------------------
# AGILE Reporting Platform - LOCAL DEVELOPMENT configuration
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# These defaults are for a machine on your desk. For a server on the internet
# use .env.production.example instead: the app refuses to start with
# ENVIRONMENT=production while any of these defaults are still in place.
#
# Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME="AGILE Reporting Platform"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# Database. SQLite by default; point at PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://agile:secret@localhost:5432/agile
DATABASE_URL=sqlite:///./storage/agile.db

# Security -------------------------------------------------------------------
# MUST be overridden in production with a long random value.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# Bootstrap admin account created by `python -m scripts.seed`
BOOTSTRAP_ADMIN_EMAIL=admin@agile.gov.ng
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2024

# Storage --------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=50

# Data quality ---------------------------------------------------------------
# Submissions scoring below this overall DQA score cannot be approved.
DQA_MINIMUM_SCORE=60
# Period-over-period change above this percentage is flagged as inconsistent.
CONSISTENCY_CHANGE_THRESHOLD_PCT=200
# Achievement above this percentage of target is flagged as implausible.
ACCURACY_TARGET_RATIO_PCT=300

# Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
# Structured JSON is right for a server; plain lines are readable at a desk.
LOG_JSON=false

# CORS -----------------------------------------------------------------------
# Sites allowed to call the API from a browser. Empty means same-origin only,
# which is all the bundled dashboard needs. Only list origins here if something
# else calls the API from a browser.
#
# "*" is refused when ENVIRONMENT=production: the API accepts a session cookie,
# and with credentials enabled "*" makes the server echo back any origin.
CORS_ORIGINS=
