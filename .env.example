# ---------------------------------------------------------------------------
# AGILE Reporting Platform - environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME="AGILE Reporting Platform"
ENVIRONMENT=development           # development | staging | production
DEBUG=true

# Database. SQLite by default; point at PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://agile:secret@localhost:5432/agile
DATABASE_URL=sqlite:///./storage/agile.db

# Security -------------------------------------------------------------------
# MUST be overridden in production with a long random value.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720

# Bootstrap admin account created by `python -m scripts.seed`
BOOTSTRAP_ADMIN_EMAIL=admin@agile.gov.ng
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2024

# Storage --------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=50

# Data quality ---------------------------------------------------------------
# Submissions scoring below this overall DQA score cannot be approved.
DQA_MINIMUM_SCORE=60
# Period-over-period change above this percentage is flagged as inconsistent.
CONSISTENCY_CHANGE_THRESHOLD_PCT=200
# Achievement above this percentage of target is flagged as implausible.
ACCURACY_TARGET_RATIO_PCT=300

# Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# CORS (comma-separated origins for external dashboards; * allows all)
CORS_ORIGINS=*
