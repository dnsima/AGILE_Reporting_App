# AGILE Reporting Platform — deployment settings.
#
#   cp .env.production.example .env
#
# The app refuses to start with ENVIRONMENT=production if any of the first
# four are left at their defaults. That is deliberate: a warning in a container
# log scrolls past, and the consequence is real state data signed with a key
# published in this repository.

# --- The domain Caddy will obtain an HTTPS certificate for ------------------
# A DNS A record for this name must already point at this server.
AGILE_DOMAIN=agile.example.org

# --- Secrets ----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The first administrator. Sign in, change the password from inside the app,
# then create the real NPCU and state accounts.
BOOTSTRAP_ADMIN_EMAIL=admin@agile.gov.ng
BOOTSTRAP_ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=agile
POSTGRES_PASSWORD=
POSTGRES_DB=agile

# --- Browser access ---------------------------------------------------------
# Leave empty for same-origin only, which is what the bundled dashboard needs.
# Only list origins here if something other than this server's own dashboard
# calls the API from a browser. "*" is refused in production.
CORS_ORIGINS=

# --- Optional ---------------------------------------------------------------
# How long a signed-in session lasts, in minutes. 720 is twelve hours.
ACCESS_TOKEN_TTL_MINUTES=720
# Largest workbook accepted on upload, in megabytes. Keep Caddy's
# request_body max_size above this.
MAX_UPLOAD_MB=50
